/node_modules
/public/hot
/public/storage
/vendor

.env
.env.*
!.env.example

/storage/*.key
/storage/*.xlsx
/storage/leads.xlsx
/storage/logs/*.log

# Runtime caches (directory scaffolds stay via nested .gitignore)
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/framework/testing/*
!/storage/framework/testing/.gitignore

# User uploads / KYC / deposit proofs / personal photos — never commit
/storage/app/public/photos/*
!/storage/app/public/photos/.gitignore
/storage/app/public/uploads/*
!/storage/app/public/uploads/.gitignore
/storage/app/livewire-tmp/*
!/storage/app/livewire-tmp/.gitignore
/storage/app/temp/*
!/storage/app/temp/.gitignore

# Bootstrap cache: keep discover manifests, ignore other generated PHP
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
!/bootstrap/cache/packages.php
!/bootstrap/cache/services.php

.phpunit.result.cache
docker-compose.override.yml
Homestead.json
Homestead.yaml
npm-debug.log
yarn-error.log
/.idea
/.vscode
/temp
*.log
.DS_Store
Thumbs.db

# Secrets / dumps / backups
*.pem
*.p12
*.pfx
*.dump
*.bak
*.sql.gz
